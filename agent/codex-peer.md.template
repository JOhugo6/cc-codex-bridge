  # Native executable and escaped YAML scalars: no cmd.exe shell is necessary.
  - codex_bridge:
      type: stdio
      command: {{NODE_COMMAND_JSON}}
      args: {{NODE_ARGS_JSON}}
      env: {{NODE_ENV_JSON}}
